QSIGN_ENV=local
QSIGN_API_HOST=0.0.0.0
QSIGN_API_PORT=18080

POSTGRES_DB=qsign
POSTGRES_USER=qsign
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql://qsign:change-me-local@postgres:5432/qsign

S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=qsign-assets
S3_ACCESS_KEY=qsign-local
S3_SECRET_KEY=change-me-local-minio

QSIGN_MODEL_CACHE=/models
QSIGN_ASSET_ROOT=/assets
QSIGN_REVIEW_TOKEN=change-me-review-token
QSIGN_REVIEW_SESSION_SECRET=change-me-session-secret

# Staged Platform integration. Disabled is the safe production default until
# the protected QazCompute and id.qdev.run acceptance receipts exist.
QSIGN_QAZCOMPUTE_LANGUAGE_ROUTING_MODE=disabled
QSIGN_QAZCOMPUTE_LANGUAGE_ROUTING_ENDPOINT=
QSIGN_QAZCOMPUTE_LANGUAGE_ROUTING_API_KEY=
QSIGN_QAZCOMPUTE_LANGUAGE_ROUTING_TIMEOUT_SECONDS=1.0
QSIGN_IDENTITY_MODE=documented
QSIGN_IDENTITY_ISSUER=https://id.qdev.run
QSIGN_IDENTITY_AUDIENCE=
QSIGN_IDENTITY_PROVIDER_ACCEPTED=false
